# Server Configuration
PORT=3000

# Database Configuration
DB_HOST=localhost
DB_PORT=3306
DB_NAME=logistics_db
DB_USER=root
DB_PASSWORD=your_secure_password_here

# JWT Configuration
# Use strong, random strings (minimum 32 characters recommended)
JWT_SECRET=your_strong_jwt_secret_key_min_32_characters_long
ACCESS_TOKEN_SECRET=your_strong_access_token_secret_key_min_32_chars
REFRESH_TOKEN_SECRET=your_strong_refresh_token_secret_key_min_32_chars

# Token Expiry
ACCESS_TOKEN_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=7d

# Razorpay Payment Gateway
# Get these from your Razorpay dashboard: https://dashboard.razorpay.com
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your_razorpay_secret_key_here
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret_here

# Optional: Node Environment
# NODE_ENV=development
